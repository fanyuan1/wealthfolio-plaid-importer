{
  "name": "plaid-importer",
  "version": "0.1.4",
  "private": true,
  "description": "Import bank, card and brokerage data from Plaid into Wealthfolio",
  "type": "module",
  "main": "dist/addon.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanyuan1/wealthfolio-plaid-importer.git"
  },
  "homepage": "https://github.com/fanyuan1/wealthfolio-plaid-importer#readme",
  "bugs": "https://github.com/fanyuan1/wealthfolio-plaid-importer/issues",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "bundle": "scripts/bundle.sh dist",
    "bundle:local": "scripts/bundle.sh dist/local",
    "release": "scripts/release.sh",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "wf:up": "f=test/docker/.env; [ -f $f ] || echo \"WF_SECRET_KEY=$(openssl rand -base64 32)\" > $f; docker compose -p plaid-wf -f test/docker/compose.yml --env-file $f up -d --wait",
    "wf:install": "scripts/bundle.sh node_modules/.cache/plaid-importer-wf && node test/docker/install.mjs node_modules/.cache/plaid-importer-wf",
    "wf:down": "docker compose -p plaid-wf -f test/docker/compose.yml --env-file test/docker/.env down",
    "wf:reset": "docker compose -p plaid-wf -f test/docker/compose.yml --env-file test/docker/.env down -v && rm -f test/docker/.env",
    "lint:comments": "eslint .",
    "check": "pnpm run lint:comments && pnpm run type-check && pnpm run knip && pnpm run test",
    "prepare": "husky",
    "knip": "knip"
  },
  "dependencies": {
    "big.js": "^7.0.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.12.0",
    "@wealthfolio/ui": "^3.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/big.js": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.2",
    "@wealthfolio/addon-sdk": "^3.12.0",
    "@wealthfolio/ui": "^3.12.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.1",
    "lints": "github:fanyuan1/lints#v0.5.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "eslint --no-warn-ignored"
  }
}
